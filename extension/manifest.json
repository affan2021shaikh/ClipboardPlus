{
  "manifest_version": 3,
  "name": "ClipboardPlus",
  "version": "0.1.1",
  "description": "Upload files to any site's file input from your clipboard, a URL, or a custom file — with a smart, editable filename. ",
  "icons": {
    "16": "./icons/OpenMoji-1F4CB-color.svg",
    "32": "./icons/OpenMoji-1F4CB-color.svg",
    "48": "./icons/OpenMoji-1F4CB-color.svg",
    "64": "./icons/OpenMoji-1F4CB-color.svg",
    "72": "./icons/OpenMoji-1F4CB-72x72-color.png",
    "128": "./icons/OpenMoji-1F4CB-color.svg",
    "618": "./icons/OpenMoji-1F4CB-618x618-color.png",
    "619": "./icons/OpenMoji-1F4CB-color.svg"
  },
  "permissions": ["storage", "clipboardRead", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["format.js", "content.js"],
      "css": ["popup.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ClipboardPlus@affan2021shaikh.github.io",
      "strict_min_version": "109.0"
    }
  }
}
